{
  "name": "pmgs-reference-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "build:webmcp": "esbuild webmcp/webmcp.ts --bundle --format=iife --platform=browser --target=es2024 --minify --outfile=public/assets/webmcp.js",
    "build": "npm run build:webmcp && wrangler deploy --dry-run --outdir dist",
    "benchmark:chunks": "vitest run --config vitest.benchmark.config.ts --reporter verbose --disableConsoleIntercept",
    "lint": "oxlint --deny typescript/no-floating-promises src test webmcp",
    "pretest": "npm run build:webmcp",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.webmcp.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webmcp.json --noEmit",
    "types": "wrangler types src/worker-configuration.d.ts --include-runtime false",
    "types:check": "wrangler types src/worker-configuration.d.ts --include-runtime false --check",
    "verify": "npm run types:check && npm run typecheck && npm run lint && npm test && npm run build && npm audit --audit-level=high"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.3",
    "@cloudflare/workers-types": "5.20260808.1",
    "esbuild": "0.28.1",
    "oxlint": "1.77.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "webmcp-types": "0.1.3",
    "wrangler": "4.120.0"
  }
}
