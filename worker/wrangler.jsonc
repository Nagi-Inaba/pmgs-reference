{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pmgs-reference",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "PMGS_BUCKET",
      "bucket_name": "pmgs-reference-public"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "CURRENT_RELEASE": "JPPM2026002",
    "RELEASE_CATALOG_JSON": "{\"JPPM2026002\":{\"ipc_edition\":\"8U\"}}"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
